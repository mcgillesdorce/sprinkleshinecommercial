---
import { site } from '../data/site';

interface Props {
  heading?: string;
  text?: string;
}

const {
  heading = 'Ready for a spotless space?',
  text = 'Get a free, no-obligation quote for your home or business. We reply fast.',
} = Astro.props;
---

<section class="cta-band">
  <div class="container cta-inner">
    <div>
      <h2>{heading}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-actions">
      <a href="/get-a-quote" class="btn btn-sun">Get a free quote</a>
      <a href={site.phoneHref} class="cta-phone">or call {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: linear-gradient(135deg, var(--navy) 0%, var(--aqua-dark) 100%);
    padding-block: clamp(3rem, 7vw, 4.5rem);
  }

  .cta-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .cta-band h2 {
    color: var(--white);
    margin-bottom: 0.5rem;
  }

  .cta-band p {
    color: var(--mist-soft);
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
  }

  .cta-phone {
    color: var(--mist);
    font-weight: 600;
    text-decoration: none;
  }

  .cta-phone:hover {
    color: var(--sun);
  }
</style>
