---
import { site, nav } from '../data/site';

const phoneIcon = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>`;
---

<header class="header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${site.shortName} — home`}>
      <img src="/images/logo.png" alt={site.shortName} width="52" height="52" />
      <span class="brand-name">Sparkle <span class="amp">&</span> Shine</span>
    </a>

    <nav class="nav" aria-label="Main">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <a href={site.phoneHref} class="phone-link">
        <Fragment set:html={phoneIcon} />
        <span>{site.phone}</span>
      </a>
      <a href="/get-a-quote" class="btn btn-sun header-cta">Get a Quote</a>
    </div>
  </div>
</header>

<style>
  .header {
    flex: 0 0 auto;
    background: var(--white);
    border-bottom: 1px solid var(--line);
    z-index: 20;
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: 0.7rem;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
  }

  .brand img {
    width: 52px;
    height: 52px;
    object-fit: contain;
  }

  .brand-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--navy);
    white-space: nowrap;
  }

  .amp {
    color: var(--aqua);
  }

  .nav {
    display: flex;
    gap: 1.5rem;
    margin-left: auto;
  }

  .nav a {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--navy);
    text-decoration: none;
  }

  .nav a:hover {
    color: var(--aqua);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1.1rem;
  }

  .phone-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--navy);
    text-decoration: none;
    white-space: nowrap;
  }

  .phone-link:hover {
    color: var(--aqua);
  }

  @media (max-width: 860px) {
    .phone-link span {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .nav {
      display: none;
    }

    .header-cta {
      display: none;
    }

    .header-inner {
      justify-content: space-between;
    }
  }
</style>
