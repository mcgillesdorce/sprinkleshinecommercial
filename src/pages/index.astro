---
import Base from '../layouts/Base.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';

const services = [
  { name: 'Office & janitorial', href: '/commercial-cleaning', desc: 'Daily, weekly, or custom schedules that fit your business hours.' },
  { name: 'Floor & carpet care', href: '/commercial-cleaning', desc: 'Vacuuming, mopping, waxing, buffing, and carpet cleaning.' },
  { name: 'Sanitizing & disinfection', href: '/commercial-cleaning', desc: 'Detail disinfection for healthcare, food, and high-touch spaces.' },
  { name: 'Post-construction cleanup', href: '/commercial-cleaning', desc: 'From dusty job site to move-in ready.' },
  { name: 'Recurring house cleaning', href: '/residential-cleaning', desc: 'Weekly, bi-weekly, or monthly visits that keep home feeling fresh.' },
  { name: 'Deep cleaning', href: '/residential-cleaning', desc: 'Thorough top-to-bottom scrubbing of every surface.' },
  { name: 'Move-in / move-out', href: '/residential-cleaning', desc: 'Leave it spotless — or start fresh in a truly clean home.' },
  { name: 'Windows & upholstery', href: '/residential-cleaning', desc: 'Streak-free glass and refreshed carpets and furniture.' },
];

const steps = [
  { title: 'Get your free quote', desc: 'Tell us about your space. We listen and send a customized, no-obligation quote.' },
  { title: 'Schedule your cleaning', desc: 'Pick a time that fits your life — one-time deep clean or recurring service.' },
  { title: 'Enjoy your sparkling space', desc: 'Sit back and breathe easier. We handle every detail.' },
];
---

<Base
  title="Home & Business Cleaning in Central Florida | Sparkle & Shine Cleaning"
  description="Professional residential and commercial cleaning across Central Florida — Orlando, Kissimmee, Sanford and beyond. Free quotes, flexible schedules. Call 888-404-8146."
>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">Serving {site.serviceArea}</p>
        <h1>Spotless homes and businesses, all across Central Florida.</h1>
        <p class="lead">{site.tagline} Whether it's your home or your business, we create the calm, confidence, and comfort of a truly clean space.</p>
        <div class="hero-ctas">
          <a href="/residential-cleaning" class="btn btn-sun">Home cleaning</a>
          <a href="/commercial-cleaning" class="btn btn-navy">Business cleaning</a>
        </div>
        <p class="hero-call">
          Prefer to talk? <a href={site.phoneHref}>Call {site.phone}</a>
        </p>
      </div>
      <div class="hero-art" aria-hidden="true">
        <div class="hero-ring">
          <img src="/images/logo.png" alt="" width="320" height="320" fetchpriority="high" />
        </div>
        <svg class="sparkle s1" viewBox="0 0 24 24" fill="#F2B544"><path d="M12 2l2 6.5L20.5 10 14 12l-2 6.5L10 12 3.5 10 10 8.5z"/></svg>
        <svg class="sparkle s2" viewBox="0 0 24 24" fill="#1F9AA8"><path d="M12 2l2 6.5L20.5 10 14 12l-2 6.5L10 12 3.5 10 10 8.5z"/></svg>
        <svg class="sparkle s3" viewBox="0 0 24 24" fill="#8FD3DC"><path d="M12 2l2 6.5L20.5 10 14 12l-2 6.5L10 12 3.5 10 10 8.5z"/></svg>
      </div>
    </div>
  </section>

  <div class="trust-strip">
    <div class="container trust-inner">
      <span>Free, no-obligation quotes</span>
      <span>Flexible scheduling — days, nights & weekends</span>
      <span>Homes and businesses</span>
      <span>Locally operated in Central Florida</span>
    </div>
  </div>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Two ways we help</p>
        <h2>Your home. Your business. One standard: spotless.</h2>
      </div>
      <div class="grid grid-2">
        <article class="card path-card">
          <h3>Residential cleaning</h3>
          <p>Come home to comfort, not chores. We take care of every detail so your home stays a place to rest.</p>
          <ul class="check-list">
            <li>Recurring cleaning — weekly, bi-weekly, monthly</li>
            <li>Deep cleaning of every surface</li>
            <li>Move-in / move-out cleaning</li>
            <li>Kitchens, bathrooms, windows & more</li>
          </ul>
          <a href="/residential-cleaning" class="btn btn-outline">Explore home cleaning</a>
        </article>
        <article class="card path-card">
          <h3>Commercial cleaning</h3>
          <p>A clean workspace builds trust and productivity. Make a lasting first impression on every client and employee.</p>
          <ul class="check-list">
            <li>Office cleaning on your schedule</li>
            <li>Janitorial services & restroom care</li>
            <li>Floor care, windows & disinfection</li>
            <li>Retail, warehouse, restaurant & more</li>
          </ul>
          <a href="/commercial-cleaning" class="btn btn-outline">Explore business cleaning</a>
        </article>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">What we do</p>
        <h2>Cleaning services for every space</h2>
      </div>
      <div class="grid grid-4">
        {services.map((s) => (
          <a href={s.href} class="card service-card">
            <span class="icon-chip">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 5.8a2 2 0 0 0 1.3 1.3L21 12l-5.8 1.9a2 2 0 0 0-1.3 1.3L12 21l-1.9-5.8a2 2 0 0 0-1.3-1.3L3 12l5.8-1.9a2 2 0 0 0 1.3-1.3z"/></svg>
            </span>
            <h3>{s.name}</h3>
            <p>{s.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Why Sparkle & Shine</p>
        <h2>We're more than just cleaners — we're caretakers.</h2>
      </div>
      <div class="grid grid-4">
        <div class="card">
          <h3>Flexible schedules</h3>
          <p>Days, evenings, weekends — we work around your hours, not the other way round.</p>
        </div>
        <div class="card">
          <h3>Every detail matters</h3>
          <p>Dusty baseboards to cluttered kitchens: it's the little touches that make a space shine.</p>
        </div>
        <div class="card">
          <h3>Homes and businesses</h3>
          <p>One trusted team for your house, your office, and everything in between.</p>
        </div>
        <div class="card">
          <h3>Fast, honest quotes</h3>
          <p>Tell us about your space and get a customized, no-obligation quote — free.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2>Three simple steps to a cleaner space</h2>
      </div>
      <ol class="steps grid grid-3">
        {steps.map((step, i) => (
          <li class="card step-card">
            <span class="step-num">{i + 1}</span>
            <h3>{step.title}</h3>
            <p>{step.desc}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Where we work</p>
        <h2>Serving {site.serviceArea}</h2>
        <p>
          We clean homes and businesses in {site.cities.join(', ')} and nearby communities throughout
          {' '}{site.counties.join(', ')}. Not sure if we cover your area? <a href="/get-a-quote">Ask us</a> — we
          probably do.
        </p>
      </div>
      <div class="map-wrap">
        <iframe
          src="https://www.google.com/maps?q=Central+Florida&z=8&output=embed"
          width="100%"
          height="380"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          title="Map of our Central Florida service area"
        ></iframe>
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero {
    background:
      radial-gradient(ellipse at 80% 20%, rgba(143, 211, 220, 0.35), transparent 55%),
      radial-gradient(ellipse at 15% 85%, rgba(242, 181, 68, 0.14), transparent 50%),
      var(--cloud);
    padding-block: clamp(3.5rem, 9vw, 6rem);
    overflow: hidden;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: 3rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 1.75rem;
  }

  .hero-copy .lead {
    margin-top: 1.1rem;
  }

  .hero-call {
    margin-top: 1.1rem;
    color: var(--ink-soft);
  }

  .hero-art {
    position: relative;
    display: grid;
    place-items: center;
  }

  .hero-ring {
    background: var(--white);
    border-radius: 50%;
    padding: 2.5rem;
    box-shadow: var(--shadow-lg);
  }

  .hero-ring img {
    width: min(280px, 55vw);
    height: auto;
  }

  .sparkle {
    position: absolute;
    width: 34px;
    height: 34px;
    animation: twinkle 3.2s ease-in-out infinite;
  }

  .s1 { top: 4%; right: 12%; }
  .s2 { bottom: 8%; left: 6%; width: 26px; animation-delay: 1.1s; }
  .s3 { top: 30%; left: -2%; width: 20px; animation-delay: 2s; }

  @keyframes twinkle {
    0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.9; }
    50% { transform: scale(1.25) rotate(12deg); opacity: 0.5; }
  }

  .trust-strip {
    background: var(--navy);
    color: var(--mist-soft);
    padding-block: 0.9rem;
  }

  .trust-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem 2.25rem;
    font-family: var(--font-display);
    font-size: 0.88rem;
    font-weight: 600;
    text-align: center;
  }

  .path-card h3 {
    margin-bottom: 0.6rem;
  }

  .path-card p {
    color: var(--ink-soft);
    margin-bottom: 1.1rem;
  }

  .path-card .check-list {
    margin-bottom: 1.5rem;
  }

  .service-card {
    text-decoration: none;
    color: inherit;
  }

  .service-card h3 {
    font-size: 1.1rem;
    margin-bottom: 0.4rem;
  }

  .service-card p {
    font-size: 0.95rem;
    color: var(--ink-soft);
  }

  .steps {
    list-style: none;
    padding: 0;
    counter-reset: step;
  }

  .step-card {
    position: relative;
  }

  .step-num {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    background: var(--sun);
    color: var(--navy);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    margin-bottom: 1rem;
  }

  .step-card h3 {
    margin-bottom: 0.4rem;
  }

  .step-card p {
    color: var(--ink-soft);
  }

  .map-wrap {
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-art {
      order: -1;
    }

    .hero-ring {
      padding: 1.5rem;
    }
  }
</style>
